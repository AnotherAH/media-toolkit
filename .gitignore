# NOTE: git does not support trailing comments on a pattern line -- anything
# after the pattern becomes part of the pattern. Keep comments on their own line.

# --- Python environment -----------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Build output -----------------------------------------------------------
# PyInstaller work plus the packaged app and installer. The installer alone is
# over 100 MB and GitHub rejects any single file that large, so built releases
# belong on the Releases page, not in the tree.
/build/
/dist/

# --- Bundled binaries (downloaded, not authored) ----------------------------
# ffmpeg + ffprobe are ~260 MB of static builds. setup.bat fetches them via
# tools/fetch_ffmpeg.py, so there is no reason to version them.
/bin/

# --- Runtime data (per machine, some of it private) -------------------------
# In a source checkout the data folder is the checkout itself, so these are
# anchored to the root: a folder of the same name elsewhere is real source.
# Whisper weights, several GB.
/models/
# Finished media and transcripts.
/downloads/
/transcripts/
# On-demand packs (CUDA, ffmpeg repair) and yt-dlp updates.
/runtime/
# Hugging Face cache and settings (HF_HOME points here).
/hf/
# Portable mode keeps everything in data/ beside the exe.
/data/
# Browser profiles for the app window and the sign-in flow.
/window/
/login-profile/

# Local settings, including machine-specific paths, and their backups.
/config.json
/config.json.bak
/config.json.tmp
# Half-written files the app replaces atomically (history, instance, caches).
/*.json.tmp
/config.corrupt-*.json
/.backend-cache.json
# Job history and the running instance's port and token.
/history.json
/instance.json
/instance.lock
/diagnose.txt
# LIVE SESSION COOKIES -- must never be committed.
cookies.txt
cookies.txt.tmp
/app.log
/app.log.*

# --- OS / editor ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
